# Downloaded source databases; retain task definitions, validators and manifests.
**/query_dataset/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.duckdb
*.duckdb.wal

# Local Python environments and generated caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.DS_Store

# Local credentials must never be versioned.
.env
.env.*
!.env.example

# Streaming benchmark downloads and isolated runtime caches.
*.part
*.sqlite.download
benchmark/dacomp/fullscale/runtime/

# Per-process trajectory locks are recreated by the DB tool.
benchmark/dacomp/tool-prototype/**/owner.lock

# Runtime locks for independent FAD optimization source sessions.
benchmark/dacomp/fad-optimization/**/owner.lock
