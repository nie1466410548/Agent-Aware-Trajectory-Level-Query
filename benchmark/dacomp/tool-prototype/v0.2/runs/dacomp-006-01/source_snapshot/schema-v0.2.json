{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sql": {
      "type": "string",
      "minLength": 1
    },
    "future_access": {
      "$ref": "#/$defs/futureAccess"
    }
  },
  "required": [
    "sql",
    "future_access"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "predicate"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "in",
            "between",
            "like",
            "is_null",
            "is_not_null"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "const": "unknown"
                }
              },
              "required": [
                "status"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "const": "known"
                },
                "literal": {
                  "anyOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  ]
                }
              },
              "required": [
                "status",
                "literal"
              ]
            }
          ]
        }
      },
      "required": [
        "type",
        "column",
        "op",
        "value"
      ]
    },
    "filter1": {
      "anyOf": [
        {
          "$ref": "#/$defs/predicate"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "and",
                "or"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          },
          "required": [
            "type",
            "items"
          ]
        }
      ]
    },
    "filter2": {
      "anyOf": [
        {
          "$ref": "#/$defs/predicate"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "and",
                "or"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/filter1"
              }
            }
          },
          "required": [
            "type",
            "items"
          ]
        }
      ]
    },
    "filter3": {
      "anyOf": [
        {
          "$ref": "#/$defs/predicate"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "and",
                "or"
              ]
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/filter2"
              }
            }
          },
          "required": [
            "type",
            "items"
          ]
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "columns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "known",
                "partial",
                "unknown",
                "none"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "items"
          ]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "known",
                "partial",
                "unknown",
                "none"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/filter3"
              }
            }
          },
          "required": [
            "status",
            "items"
          ]
        },
        "joins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "known",
                "partial",
                "unknown",
                "none"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "inner",
                      "left",
                      "right",
                      "full"
                    ]
                  },
                  "conditions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "left_column": {
                          "type": "string",
                          "minLength": 1
                        },
                        "op": {
                          "const": "eq"
                        },
                        "right_column": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "left_column",
                        "op",
                        "right_column"
                      ]
                    }
                  }
                },
                "required": [
                  "type",
                  "conditions"
                ]
              }
            }
          },
          "required": [
            "status",
            "items"
          ]
        },
        "group_by": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "known",
                "partial",
                "unknown",
                "none"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "const": "column"
                      },
                      "column": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "type",
                      "column"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "const": "time_bucket"
                      },
                      "column": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unit": {
                        "enum": [
                          "year",
                          "month",
                          "day"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "column",
                      "unit"
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "status",
            "items"
          ]
        },
        "aggregations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "known",
                "partial",
                "unknown",
                "none"
              ]
            },
            "items": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "function": {
                    "enum": [
                      "sum",
                      "count",
                      "avg",
                      "min",
                      "max",
                      "count_distinct"
                    ]
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "function",
                  "column"
                ]
              }
            }
          },
          "required": [
            "status",
            "items"
          ]
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "likelihood": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      },
      "required": [
        "tables",
        "columns",
        "filters",
        "joins",
        "group_by",
        "aggregations",
        "priority"
      ]
    },
    "futureAccess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "provided",
            "unknown",
            "no_further_access"
          ]
        },
        "coverage": {
          "enum": [
            "remaining_task",
            "partial_plan"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      },
      "required": [
        "status",
        "candidates"
      ]
    }
  }
}
