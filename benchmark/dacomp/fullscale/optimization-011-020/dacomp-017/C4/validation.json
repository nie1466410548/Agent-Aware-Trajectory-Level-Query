    "S31": "SELECT\n  SUBSTRING(\"Order Date\", 1, 4) AS \"yr\",\n  \"Order Priority\" AS \"Order Priority\",\n  COUNT(*) AS \"n\"\nFROM temp.\"reuse_017_c4\" AS order_information\nWHERE\n  \"Product Category\" = 'Home & Furniture'\nGROUP BY\n  yr,\n  \"Order Priority\"\nORDER BY\n  yr,\n  \"Order Priority\"",
