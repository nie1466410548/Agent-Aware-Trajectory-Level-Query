  ],
  "rewrites": {
    "S65": "SELECT\n  __g0 AS \"yr\",\n  (\n    1.0 * SUM(__a0_sum) / NULLIF(SUM(__a0_n), 0)\n  ) AS \"avg_discount\",\n  (\n    1.0 * SUM(__a1_sum) / NULLIF(SUM(__a1_n), 0)\n  ) AS \"avg_qty_discount\"\nFROM temp.\"reuse_017_c15\"\nGROUP BY\n  __g0\nORDER BY\n  yr",
    "S66": "SELECT\n  __g1 AS \"Product\",\n  (\n    1.0 * SUM(__a0_sum) / NULLIF(SUM(__a0_n), 0)\n  ) AS \"avg_discount\",\n  (\n    1.0 * SUM(__a1_sum) / NULLIF(SUM(__a1_n), 0)\n  ) AS \"avg_qty_discount\"\nFROM temp.\"reuse_017_c15\"\nGROUP BY\n  __g1\nORDER BY\n  avg_qty_discount DESC"
  },
