  "rewrites": {
    "S16": "WITH b AS (\n  SELECT\n    *\n  FROM temp.\"reuse_012_c2\"\n)\nSELECT\n  interval AS \"interval\",\n  cut AS \"cut\",\n  COUNT(*) AS \"n\",\n  ROUND(AVG(price / carat), 2) AS \"avg_ppc\"\nFROM b\nGROUP BY\n  interval,\n  cut\nORDER BY\n  interval,\n  avg_ppc DESC",
