{
  "$schema": "https://opencode.ai/config.json",
  "model": "glm-custom/DeepSeek-V4-Flash-0731",
  "small_model": "glm-custom/DeepSeek-V4-Flash-0731",
  "enabled_providers": [
    "glm-custom"
  ],
  "provider": {
    "glm-custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM Custom API",
      "options": {
        "baseURL": "http://127.0.0.1:42315",
        "apiKey": "local-relay-no-credential"
      },
      "models": {
        "DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731"
        }
      }
    }
  },
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "plugin": [],
  "instructions": [],
  "permission": {
    "*": "deny",
    "dacomp_*": "allow"
  },
  "agent": {
    "dacomp-db-first": {
      "description": "Analyze the supplied database using recorded tools.",
      "mode": "primary",
      "model": "glm-custom/DeepSeek-V4-Flash-0731",
      "prompt": "You are a data analysis agent. Follow the supplied task and database-first protocol. Use only the dacomp tools. Submit the report through dacomp_answer.",
      "permission": {
        "*": "deny",
        "dacomp_*": "allow"
      }
    }
  },
  "mcp": {
    "dacomp": {
      "type": "local",
      "command": [
        "/data/nly/Agent-Aware-Trajectory-Level-Query/benchmark/dacomp/.venv/bin/python",
        "/data/nly/Agent-Aware-Trajectory-Level-Query/benchmark/dacomp/fullscale/tools/server.py",
        "/data/nly/Agent-Aware-Trajectory-Level-Query/benchmark/dacomp/fullscale/runs/dsv4flash-db-first-full-01/dacomp-016/attempt-01"
      ],
      "enabled": true,
      "timeout": 310000
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  }
}
