{
  "version": "sqlite-fad-v1.2-sql-only-baseline",
  "min_fad_occurrences": 2,
  "max_index_objects": 2,
  "max_materialization_objects": 2,
  "max_extra_bytes": 536870912,
  "build_seconds": 120,
  "optimizer_seconds": 300,
  "query_seconds": 120,
  "absolute_tolerance": 1e-07,
  "relative_tolerance": 1e-09,
  "cache_mode": "full-base-read-then-new-connection",
  "preparation_outside_timer": [
    "copy",
    "prewarm",
    "input/config hashes",
    "result directory"
  ]
}
