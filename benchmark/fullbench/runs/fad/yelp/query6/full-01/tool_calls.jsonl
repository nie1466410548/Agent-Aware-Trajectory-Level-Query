{"task_id": "yelp/query6", "run_id": "full-01", "call_id": "a3bc4edf0b7d42c38fb10a2188f77cc4", "tool": "python", "start_time": 1788819569.8273513, "timestamp": "2026-09-07T22:19:29.827354+00:00", "code": "import json\nfrom datetime import datetime\n\nresult_file = \"/data/nly/Agent-Aware-Trajectory-Level-Query/benchmark/fullbench/runs/fad/yelp/query6/full-01/results/b466363d6ecf49caa9c94bffb194d480.json\"\nrows = json.load(open(result_file))\n\nformats = [\n    \"%Y-%m-%d %H:%M:%S\",\n    \"%Y-%m-%d %H:%M\",\n    \"%B %d, %Y at %I:%M %p\",   # August 01, 2016 at 03:44 AM\n    \"%b %d, %Y at %I:%M %p\",\n    \"%d %b %Y, %H:%M\",         # 29 May 2013, 23:01\n    \"%d %B %Y, %H:%M\",\n    \"%B %d, %Y\",               # fallback date-only variants\n    \"%b %d, %Y\",\n    \"%Y-%m-%d\",\n]\n\ndef parse(s):\n    s = s.strip()\n    for f in formats:\n        try:\n            return datetime.strptime(s, f)\n        except ValueError:\n            pass\n    return None\n\nunparsed = set()\nstart = datetime(2016, 1, 1)\nend = datetime(2016, 7, 1)  # exclusive: Jan 1 - Jun 30 inclusive\n\nin_window = []\nfor r in rows:\n    d = parse(r[\"date\"])\n    if d is None:\n        unparsed.add(r[\"date\"])\n        continue\n    if start <= d < end:\n        in_window.append((r[\"business_ref\"], r[\"rating\"]))\n\nprint(\"total rows:\", len(rows))\nprint(\"unparsed formats:\", sorted(unparsed))\nprint(\"reviews in window:\", len(in_window))\n\nfrom collections import defaultdict\nagg = defaultdict(list)\nfor b, rating in in_window:\n    agg[b].append(rating)\n\nstats = [(b, sum(v)/len(v), len(v)) for b, v in agg.items() if len(v) >= 5]\nstats.sort(key=lambda x: (-x[1], -x[2]))\nprint(\"businesses with >=5 reviews in window:\")\nfor b, avg, n in stats:\n    print(f\"  {b}: avg={avg:.4f}, n={n}\")\n", "success": true, "result_file": "/data/nly/Agent-Aware-Trajectory-Level-Query/benchmark/fullbench/runs/fad/yelp/query6/full-01/results/a3bc4edf0b7d42c38fb10a2188f77cc4.json", "result_bytes": 253, "result_sha256": "669c478335c5b5b36d3c00f3f40a27b4b13aaaef37539e7093273d8b12f33818", "end_time": 1788819569.9112797, "duration_ms": 83.91244616359472}
