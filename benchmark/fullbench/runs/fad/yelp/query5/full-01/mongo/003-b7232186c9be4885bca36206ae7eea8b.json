{
  "operation": "find",
  "collection": "business",
  "filter": {
    "attributes.WiFi": {
      "$nin": [
        "u'no'",
        "no",
        "u'None'"
      ],
      "$exists": true
    }
  },
  "projection": {
    "business_id": 1,
    "attributes.WiFi": 1,
    "description": 1
  },
  "limit": 100000
}
