{
  "operation": "aggregate",
  "collection": "articles",
  "pipeline": [
    {
      "$match": {
        "$or": [
          {
            "title": {
              "$regex": "business",
              "$options": "i"
            }
          },
          {
            "description": {
              "$regex": "business",
              "$options": "i"
            }
          }
        ]
      }
    },
    {
      "$count": "n"
    }
  ]
}
