{
  "operation": "find",
  "collection": "articles",
  "filter": {
    "$or": [
      {
        "title": {
          "$regex": "business",
          "$options": "i"
        }
      },
      {
        "description": {
          "$regex": "business",
          "$options": "i"
        }
      }
    ]
  },
  "projection": {
    "article_id": 1,
    "_id": 0
  },
  "limit": 10000
}
