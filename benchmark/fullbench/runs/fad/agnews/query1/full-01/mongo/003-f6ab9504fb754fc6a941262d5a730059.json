{
  "operation": "aggregate",
  "collection": "articles",
  "pipeline": [
    {
      "$project": {
        "article_id": 1,
        "title": 1,
        "description": 1,
        "desc_len": {
          "$strLenCP": "$description"
        }
      }
    },
    {
      "$sort": {
        "desc_len": -1
      }
    },
    {
      "$limit": 40
    }
  ]
}
