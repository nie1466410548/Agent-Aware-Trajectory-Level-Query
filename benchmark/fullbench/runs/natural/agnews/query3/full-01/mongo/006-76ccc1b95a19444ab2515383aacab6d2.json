{
  "operation": "find",
  "collection": "articles",
  "filter": {
    "$or": [
      {
        "title": {
          "$regex": "business",
          "$options": "i"
        }
      },
      {
        "description": {
          "$regex": "business",
          "$options": "i"
        }
      }
    ]
  },
  "projection": {
    "_id": 0,
    "article_id": 1
  }
}
