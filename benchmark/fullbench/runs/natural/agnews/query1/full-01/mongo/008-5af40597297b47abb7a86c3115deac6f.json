{
  "operation": "aggregate",
  "collection": "articles",
  "pipeline": [
    {
      "$project": {
        "_id": 0,
        "article_id": 1,
        "title": 1,
        "description": 1,
        "len": {
          "$strLenCP": "$description"
        }
      }
    },
    {
      "$sort": {
        "len": -1
      }
    },
    {
      "$limit": 100
    }
  ]
}
