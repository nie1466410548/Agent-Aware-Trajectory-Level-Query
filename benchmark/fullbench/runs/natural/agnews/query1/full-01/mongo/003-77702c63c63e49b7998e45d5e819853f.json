{
  "operation": "aggregate",
  "collection": "articles",
  "pipeline": [
    {
      "$project": {
        "keys": {
          "$objectToArray": "$$ROOT"
        }
      }
    },
    {
      "$unwind": "$keys"
    },
    {
      "$group": {
        "_id": "$keys.k",
        "count": {
          "$sum": 1
        }
      }
    }
  ]
}
